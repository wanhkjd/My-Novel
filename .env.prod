# =============================================================
#           Novel 项目 - 生产环境 (PROD) 环境变量模版
# =============================================================

# 激活 Profile（强制指定生产环境）
SPRING_PROFILES_ACTIVE=prod

# 服务端口
SERVER_PORT=8888

# ----------------- Spring AI (大模型配置) -----------------
# 生产环境 AI API 密钥与地址
AI_API_KEY=your_production_siliconflow_api_key_here
AI_BASE_URL=https://api.siliconflow.cn
AI_MODEL=deepseek-ai/DeepSeek-R1-0528-Qwen3-8B

# ----------------- 数据库配置 (MySQL) -----------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=novel
DB_USERNAME=novel_prod_user
DB_PASSWORD=your_secure_db_password_here
# 如需指定完整 JDBC URL，可解开下行注释
# DB_URL=jdbc:mysql://127.0.0.1:3306/novel?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
SHARDINGSPHERE_ENABLED=false
FLYWAY_ENABLED=false
FLYWAY_BASELINE_ON_MIGRATE=true

# ----------------- Redis 配置 -----------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_DATABASE=0

# ----------------- Elasticsearch 配置 -----------------
ES_ENABLED=false
ES_URIS=https://your-es-cluster:9243
ES_USERNAME=elastic
ES_PASSWORD=your_es_password

# ----------------- RabbitMQ 消息队列配置 -----------------
AMQP_ENABLED=false
RABBITMQ_ADDRESSES=amqp://username:password@rabbitmq-host:5672
RABBITMQ_VIRTUAL_HOST=novel

# ----------------- XXL-JOB 分布式任务调度配置 -----------------
XXL_JOB_ENABLED=false
XXL_JOB_ADMIN_ADDRESSES=http://xxl-job-admin:8080/xxl-job-admin
XXL_JOB_EXECUTOR_APPNAME=xxl-job-executor-novel
XXL_JOB_EXECUTOR_LOGPATH=/data/novel/logs/xxl-job
XXL_JOB_ACCESS_TOKEN=your_secure_xxl_job_token

# ----------------- 邮件服务配置 -----------------
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USERNAME=your_email@163.com
MAIL_PASSWORD=your_email_auth_code
MAIL_NICKNAME=Novel小说平台

# ----------------- 安全与监控配置 -----------------
SBA_CLIENT_ENABLED=false
SBA_CLIENT_URL=http://localhost:8080
SBA_CLIENT_USERNAME=admin
SBA_CLIENT_PASSWORD=your_strong_admin_password
SECURITY_USER_NAME=ENDPOINT_ADMIN
SECURITY_USER_PASSWORD=your_strong_endpoint_password
MANAGEMENT_ENDPOINTS_INCLUDE=health,info,metrics

# ----------------- Swagger/OpenAPI 文档 -----------------
# 生产环境默认关闭接口文档
SPRINGDOC_ENABLED=false

# ----------------- Novel 自定义业务配置 -----------------
NOVEL_WEBSITE_NAME=Novel小说网
NOVEL_WEBSITE_LINK=https://www.yourdomain.com
NOVEL_WEBSITE_SUPPORT_EMAIL=support@yourdomain.com
# 生产环境务必更换强 JWT 密钥（至少32位字符）
NOVEL_JWT_SECRET=YOUR_PRODUCTION_VERY_STRONG_JWT_SECRET_KEY_123456
NOVEL_XSS_ENABLED=true
# 生产环境 Linux 上传文件挂载目录
NOVEL_FILE_UPLOAD_PATH=/data/novel/uploads
LOG_LEVEL=INFO
LOG_FILE_PATH=/data/novel/logs/novel.log
PROD_DOMAIN=https://www.yourdomain.com
