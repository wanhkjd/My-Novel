# ==============================================================================
#            Novel 项目环境变量全量说明模版 (.env.example)
# ==============================================================================
# 使用方式：
# 1. 本地开发：复制 .env.dev 为 .env 或在 IDE Run Configuration / docker-compose 中加载
# 2. 生产部署：复制 .env.prod 为 .env，填入生产真实密钥及配置
# 3. 命令行运行：
#    Windows PowerShell:  $env:SPRING_PROFILES_ACTIVE="prod"; java -jar novel.jar
#    Linux Bash:          export SPRING_PROFILES_ACTIVE=prod && java -jar novel.jar
#    Spring Boot 原生传参: java -jar novel.jar --spring.profiles.active=prod
# ==============================================================================

# ----------------- 1. 基础服务配置 -----------------
# 激活环境（dev: 开发环境, prod: 生产环境）
SPRING_PROFILES_ACTIVE=dev
# 服务启动端口
SERVER_PORT=8888
# 上传文件大小限制
MULTIPART_MAX_FILE_SIZE=5MB
MULTIPART_MAX_REQUEST_SIZE=10MB

# ----------------- 2. Spring AI (大模型) -----------------
# SiliconFlow / OpenAI API Key
AI_API_KEY=sk-xxxx
# AI 接口 Base URL
AI_BASE_URL=https://api.siliconflow.cn
# 使用的大模型名称
AI_MODEL=deepseek-ai/DeepSeek-R1-0528-Qwen3-8B

# ----------------- 3. 数据库与分库分表 -----------------
# MySQL 主机 IP 或域名
DB_HOST=127.0.0.1
# MySQL 端口
DB_PORT=3306
# 数据库名
DB_NAME=novel
# 数据库用户名
DB_USERNAME=root
# 数据库密码
DB_PASSWORD=123
# 完整 JDBC 连接串（如不配置则自动根据 DB_HOST/DB_PORT/DB_NAME 组合）
DB_URL=jdbc:mysql://127.0.0.1:3306/novel?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
# 是否开启 ShardingSphere 分库分表（true/false）
SHARDINGSPHERE_ENABLED=false
# Flyway 数据库迁移开关
FLYWAY_ENABLED=false
FLYWAY_BASELINE_ON_MIGRATE=true

# ----------------- 4. Redis 缓存 -----------------
# Redis 主机地址
REDIS_HOST=127.0.0.1
# Redis 端口
REDIS_PORT=6379
# Redis 密码（无密码则留空）
REDIS_PASSWORD=
# Redis 数据库库号（0-15）
REDIS_DATABASE=0

# ----------------- 5. Elasticsearch 搜索引擎 -----------------
# 是否开启 ES 搜索引擎（true/false）
ES_ENABLED=false
# ES 节点地址（多个以逗号分隔）
ES_URIS=http://127.0.0.1:9200
# ES 认证用户名与密码
ES_USERNAME=elastic
ES_PASSWORD=

# ----------------- 6. RabbitMQ 消息队列 -----------------
# 是否开启 AMQP（true/false）
AMQP_ENABLED=false
# RabbitMQ 连接串
RABBITMQ_ADDRESSES=amqp://guest:guest@127.0.0.1:5672
# RabbitMQ VirtualHost
RABBITMQ_VIRTUAL_HOST=novel

# ----------------- 7. XXL-JOB 分布式任务调度 -----------------
# 是否开启 XXL-JOB（true/false）
XXL_JOB_ENABLED=false
# 调度中心地址
XXL_JOB_ADMIN_ADDRESSES=http://127.0.0.1:8080/xxl-job-admin
# 执行器 AppName
XXL_JOB_EXECUTOR_APPNAME=xxl-job-executor-novel
# 执行器日志存储目录
XXL_JOB_EXECUTOR_LOGPATH=logs/xxl-job/jobhandler
# XXL-JOB AccessToken
XXL_JOB_ACCESS_TOKEN=123

# ----------------- 8. 邮件服务 -----------------
# SMTP 服务器地址
MAIL_HOST=smtp.163.com
# SMTP 端口
MAIL_PORT=465
# 邮箱发件人账号
MAIL_USERNAME=xxx@163.com
# 邮箱第三方授权码（非邮箱登录密码）
MAIL_PASSWORD=xxx
# 邮件发件人展示昵称
MAIL_NICKNAME=Novel

# ----------------- 9. 监控与安全 -----------------
# Spring Boot Admin 客户端开关
SBA_CLIENT_ENABLED=false
# SBA 服务端地址
SBA_CLIENT_URL=http://localhost:8080
# SBA 认证用户名与密码
SBA_CLIENT_USERNAME=novel
SBA_CLIENT_PASSWORD=novel
# Actuator 端点认证用户名与密码
SECURITY_USER_NAME=ENDPOINT_ADMIN
SECURITY_USER_PASSWORD=ENDPOINT_ADMIN
# Actuator 公开端点（生产建议 health,info,metrics）
MANAGEMENT_ENDPOINTS_INCLUDE=*

# ----------------- 10. 接口文档 -----------------
# 是否启用 SpringDoc / Swagger 接口文档（dev 默认 true，prod 默认 false）
SPRINGDOC_ENABLED=true

# ----------------- 11. Novel 自定义业务配置 -----------------
# 网站名称
NOVEL_WEBSITE_NAME=Novel
# 网站前端访问链接
NOVEL_WEBSITE_LINK=http://localhost:1024
# 支持邮箱
NOVEL_WEBSITE_SUPPORT_EMAIL=support@novel.local
# JWT 签名密钥（生产环境必须修改为随机高强度字符串）
NOVEL_JWT_SECRET=E66559580A1ADF48CDD928516062F12E
# XSS 防护开关
NOVEL_XSS_ENABLED=true
# 上传文件存储目录（Linux如 /data/novel/uploads，Windows如 D:/novel/uploads）
NOVEL_FILE_UPLOAD_PATH=./uploads
# 全局日志级别（DEBUG, INFO, WARN, ERROR）
LOG_LEVEL=INFO
# 日志文件存储路径
LOG_FILE_PATH=logs/novel.log
# 生产环境允许的跨域域名
PROD_DOMAIN=https://www.yourdomain.com
